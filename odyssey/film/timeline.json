  "texts": [
    {
      "t0": 1.8,
      "t1": 6.4,
      "style": "epigraph",
      "el": "ἄνδρα μοι ἔννεπε, μοῦσα, πολύτροπον",
      "ja": "語れ、ムーサよ——あまたの道をさまよった、あの男のことを。"
    },
    {
      "t0": 8.2,
      "t1": 12.2,
      "style": "chapter",
      "ja": "一瞬",
      "en": "THE SHUTTER  ·  1/125 SEC"
    },
    {
      "t0": 13.5,
      "t1": 18.5,
      "style": "line",
      "ja": "書類は言う——これがお前だ、と。",
      "en": "The document says: this is you."
    },
    {
      "t0": 21.0,
      "t1": 25.6,
      "style": "drift",
      "words": [
        "氏名",
        "国籍",
        "生年月日",
        "署名",
        "Nom",
        "Signature du titulaire"
      ]
    },
    {
      "t0": 25.8,
      "t1": 30.4,
      "style": "line",
      "ja": "この顔は、誰のものか。",
      "en": "Whose face is this?",
      "type": true
    },
    {
      "t0": 32.0,
      "t1": 36.0,
      "style": "chapter",
      "ja": "十年",
      "en": "THE SEA  ·  TEN YEARS"
    },
    {
      "t0": 38.8,
      "t1": 43.8,
      "style": "line",
      "ja": "十年、海は彼を返さなかった。",
      "en": "For ten years, the sea would not give him back."
    },
    {
      "t0": 45.8,
      "t1": 49.8,
      "style": "chapter",
      "ja": "一夜",
      "en": "THE PALACE  ·  ONE NIGHT"
    },
    {
      "t0": 50.5,
      "t1": 54.6,
      "style": "line",
      "ja": "ゆく河の流れは絶えずして、しかも、もとの水にあらず。",
      "en": "The river flows on without end — and it is never the same water.",
      "cite": "鴨長明『方丈記』 1212"
    },
    {
      "t0": 55.0,
      "t1": 58.8,
      "style": "line",
      "ja": "竜宮の一夜は、地上の三百年。",
      "en": "One night in the Dragon Palace — three hundred years above."
    },
    {
      "t0": 47.0,
      "t1": 59.0,
      "style": "counter"
    },
    {
      "t0": 61.0,
      "t1": 65.5,
      "style": "line",
      "ja": "海が、立ち上がる。",
      "en": "The sea stands up."
    },
    {
      "t0": 74.2,
      "t1": 78.2,
      "style": "line",
      "ja": "名を問われ、彼は答えた——",
      "en": "Asked his name, he answered —",
      "type": true
    },
    {
      "t0": 79.0,
      "t1": 85.0,
      "style": "big",
      "ja": "誰でもない。",
      "en": "ΟΥΤΙΣ  ·  Nobody."
    },
    {
      "t0": 88.2,
      "t1": 93.6,
      "style": "tunnel",
      "word": "わたし"
    },
    {
      "t0": 94.0,
      "t1": 100.8,
      "style": "line",
      "ja": "自己をならふといふは、自己をわするるなり。",
      "en": "To study the self is to forget the self.",
      "cite": "道元『正法眼蔵・現成公案』 1233"
    },
    {
      "t0": 103.4,
      "t1": 108.2,
      "style": "line",
      "ja": "織っては、ほどく。",
      "en": "Weave — and unweave.",
      "reverse": true
    },
    {
      "t0": 109.6,
      "t1": 115.8,
      "style": "line",
      "ja": "ほどいては、また織る。待つこともまた、航海である。",
      "en": "Unweave — and weave again. Waiting, too, is a voyage."
    },
    {
      "t0": 118.4,
      "t1": 122.8,
      "style": "line",
      "ja": "開けてはならぬ、と言われた箱。",
      "en": "The box he was told never to open."
    },
    {
      "t0": 128.6,
      "t1": 132.4,
      "style": "line",
      "ja": "開ければ、三百年が一息に来る。",
      "en": "Open it, and three hundred years arrive in a single breath."
    },
    {
      "t0": 132.8,
      "t1": 137.8,
      "style": "line",
      "ja": "老いた乳母は、足の傷で彼を知った。",
      "en": "The old nurse knew him by the scar on his leg."
    },
    {
      "t0": 139.6,
      "t1": 144.4,
      "style": "line",
      "ja": "傷は、帰郷の証。",
      "en": "The scar is the proof of return."
    },
    {
      "t0": 145.8,
      "t1": 151.4,
      "style": "line",
      "ja": "使命——それは、命を使うこと。",
      "en": "使命, mission: to spend one's life."
    },
    {
      "t0": 152.8,
      "t1": 159.2,
      "style": "line",
      "ja": "還るとは、同じ場所に、別の者として立つこと。",
      "en": "To return is to stand in the same place as someone else."
    },
    {
      "t0": 168.4,
      "t1": 172.2,
      "style": "line",
      "ja": "日々旅にして、旅を栖とす。",
      "en": "Every day a journey — and the journey itself, home.",
      "cite": "松尾芭蕉『おくのほそ道』 1702"
    },
    {
      "t0": 172.6,
      "t1": 176.2,
      "style": "title_a"
    },
    {
      "t0": 176.0,
      "t1": 179.6,
      "style": "title_b"
    }
  ],
