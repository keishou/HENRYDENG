# ---- 服务器 ----
PORT=8787
# 对外访问地址（OAuth 回调用），本地开发保持 localhost
PUBLIC_URL=http://localhost:8787
# 可选：设置后 /api 与 /push 接口需要携带 x-app-key 头（前端设置页填写）
APP_PASSWORD=

# ---- Oura OAuth2（在 https://cloud.ouraring.com/oauth/applications 注册应用）----
# Redirect URI 填：${PUBLIC_URL}/auth/callback
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# 申请的 scope（空格分隔）。daily 覆盖 sleep/readiness/activity/sleep_time；stress 覆盖 daily_stress
OURA_SCOPES=daily heartrate stress tag

# ---- 推送 / 每日计划 ----
# 每天几点（本地时间，HH:MM）自动拉取 Oura 数据、生成当日计划并推送提醒
DAILY_PLAN_AT=08:30
# IANA 时区，留空则用系统时区
TZ=Asia/Shanghai
# VAPID 联系邮箱（web push 要求），随意填一个可用邮箱
VAPID_SUBJECT=mailto:you@example.com
